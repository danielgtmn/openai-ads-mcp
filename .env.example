# Copy to .env for local runs. Never commit the filled-in file.

# Ads API key from Ads Manager settings. Sent only to api.ads.openai.com.
OPENAI_ADS_API_KEY=

# Shared secret your MCP client sends as: Authorization: Bearer <token>
MCP_AUTH_TOKEN=

# Write tools are registered only when this is exactly false.
# Any other value, including empty or unset, keeps the server read-only.
MCP_READ_ONLY=true

HOST=0.0.0.0
PORT=8000
OPENAI_ADS_BASE_URL=https://api.ads.openai.com/v1
LOG_LEVEL=INFO

# Advertiser API quotas: 600 requests/minute per endpoint and 1200 overall.
ADS_ENDPOINT_RATE_LIMIT=600
ADS_GLOBAL_RATE_LIMIT=1200
ADS_RATE_WINDOW_SECONDS=60
ADS_MAX_RETRIES=5
ADS_RETRY_BASE_SECONDS=1
ADS_RETRY_MAX_SECONDS=30
ADS_REQUEST_TIMEOUT_SECONDS=30
ADS_MAX_PAGES=25
